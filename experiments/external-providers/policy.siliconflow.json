          "model": "siliconflow/deepseek-ai/DeepSeek-V4-Flash"
        },
        {
          "model": "siliconflow/deepseek-ai/DeepSeek-V4-Pro"
        }
      ]
    }
  },
  "rules": [],
  "observeDefaults": {
    "openai-chat": "siliconflow/deepseek-ai/DeepSeek-V4-Flash",
    "openai-responses": "global.openai.gpt-6-luna",
