{
  "name": "@auto-router/catalog-service",
  "version": "0.0.0",
  "license": "MIT-0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check:strip": "node ../../scripts/node-strip-check.mjs --import src/grant-handler.ts --import src/cleanup-handler.ts --import src/refresh-handler.ts src"
  },
  "dependencies": {
    "@auto-router/core": "workspace:*",
    "@auto-router/pricing": "workspace:*",
    "@aws-sdk/client-bedrock": "3.1164.0",
    "@aws-sdk/client-iam": "3.1164.0",
    "@aws-sdk/client-lambda": "3.1164.0",
    "@aws-sdk/client-pricing": "3.1164.0",
    "@aws-sdk/client-s3": "3.1164.0"
  }
}
